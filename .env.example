# Copy to .env.local for local development. On Vercel, set these in
# Project Settings > Environment Variables.

# Added automatically when you connect a Neon database from the Vercel
# Storage tab. Leave unset locally to use the embedded database in .pglite/.
DATABASE_URL=

# Password for /admin, where the clinic reads call-back requests.
# Use a long passphrase (16+ characters). Changing it signs everyone out.
ADMIN_PASSWORD=
